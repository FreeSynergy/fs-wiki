# The words of the wiki window, English (ADR 0057: MessageFormat 2). Every id needs a German twin in de.mf2.
# A hole `{$x}` is filled with the thing the sentence talks about. The words of the layouts (wk-) and of the reader (rd-)
# are what fs-components asks for; a `{}` in them is made from the argument `{$hole}` that holds the two characters.

menu-program = Program
menu-quit = Quit
menu-view = View
menu-frontend = Frontend: {$name}
menu-page = Page
page-new = New page
page-subpage = New subpage
page-rename = Rename
page-delete = Delete
page-discard = Discard draft
reason-read-only = read only: this wiki is not edited here
reason-no-page = no page is open
reason-no-draft = nothing is being edited
reason-editing = finish the edit first
reason-variants = pages with language variants are not changed here

msg-need-page = Open a page first: the new page becomes its subpage.
msg-finish-edit = Save or discard the changes first, then change the pages.
msg-created = Page made ({$path}). Write the text, then save (Ctrl+S).
msg-renamed = Page renamed: now {$path}. Its subpages and the links to it moved along; its history stays.
msg-deleted = Moved to the trash: {$title}. It can be restored from the trash (Admin window).
msg-discarded = The draft is discarded.
msg-discarded-new = The new page was never saved; it moved to the trash.
msg-frontend-not-kept = The frontend could not be remembered.

dlg-delete-title = Delete {$title}?
dlg-delete-body = The page moves to the trash. It can be restored from there.
dlg-delete-body-sub =
  .input {$count :number}
  .match $count one {{The page and its subpages ({$count} page in all) move to the trash. They can be restored from there.}} * {{The page and its subpages ({$count} pages in all) move to the trash. They can be restored from there.}}
dlg-delete-yes = Delete
dlg-discard-title = Discard the draft of {$title}?
dlg-discard-body = What you typed is not saved and will be lost.
dlg-discard-new-body = The page was made just now and never saved. It moves to the trash.
dlg-discard-yes = Discard
dlg-keep = Keep

err-read-only = The wiki is read only here; nothing was changed.
err-empty = The name is empty.
err-no-letter = The name needs at least one letter or digit to make a path from.
err-chars = The name must not contain a slash, a backslash or control characters.
err-taken = A page called {$name} exists already.
err-invalid = The path is not allowed ({$why}).
err-failed = This did not work: {$why}
err-not-found = There is no page at {$path} any more.
err-variants = Pages with language variants are not changed in this window.
err-index = An index page has the name of its folder; rename the folder in the Admin window.
err-partial = The page was renamed and is now at {$path}, but the title in its text could not be changed: {$why}
err-half = Only part of it was done: {$why}. Nothing is lost; look at the page tree and the trash.
err-reserved = The name index is kept for the index page of a folder; take another name.

wk-program = FreeSynergy Wiki
wk-pages = Pages
wk-filter = Search by title
wk-outline = Outline
wk-no-headings = No headings on this page.
wk-history = History
wk-no-history = No earlier versions known.
wk-state-current = Current
wk-state-outdated = Outdated
wk-state-fallback = Other language
wk-language = Language
wk-edit = Edit
wk-share = Share
wk-block-hint = Type, or press / for commands
wk-title-hint = Untitled
wk-page-count =
  .input {$n :number}
  .match $n one {{{$hole} page}} * {{{$hole} pages}}

rd-search = Search pages
rd-back = Back
rd-edit = Edit
rd-save = Save
rd-cancel = Cancel
rd-export = Export
rd-nothing-open = Nothing to show.
rd-nothing-found = Nothing found for "{$hole}".
rd-unreadable = This could not be read: {$hole}
rd-missing-target = There is nothing at "{$hole}".
rd-unsaved = Save or cancel your changes first.
rd-discard-confirm = You have unsaved changes. Press Cancel again to discard them.
rd-saved = Saved.
rd-no-changes = Nothing was changed.
rd-not-saved = Not saved: {$hole}
rd-tasks-locked = You cannot change this page, so its checkboxes are locked.
rd-cannot-edit = Cannot edit this: {$hole}
rd-not-exported = Not exported: {$hole}
rd-overwrite-confirm = {$hole} Press Export again to replace it.
rd-lossy = Saving will also change: {$hole}.
rd-conflict-confirm = {$hole} Your text is kept. Press Save again to replace their version.
rd-backup-found = A draft you did not save was backed up earlier.
rd-restore = Restore
rd-discard = Discard
rd-backup-stale = The document changed after this draft was made. Saving asks before it replaces the newer version.
rd-restore-confirm = Restoring replaces what you typed. Press Restore again to do it.
rd-backup-mismatch = A stored draft belongs to another document ("{$hole}") and was not offered.
rd-backup-failed = Backup of your draft failed: {$hole}
rd-glyphs-missing = Some characters cannot be shown because no installed font has them ({$hole}). Install a font that covers their script, for example Noto Sans.
rd-glyphs-titles = Some titles in the list use characters it cannot draw ({$hole}).
rd-glyphs-more = and {$hole} more
rd-list-failed = The list failed: {$hole}
rd-search-failed = The search failed: {$hole}

admin-menu-program = Program
admin-menu-view = View
admin-menu-help = Help
admin-menu-quit = Quit
admin-menu-about = About
admin-action-add = Add
admin-action-back = Back
admin-action-cancel = Cancel
admin-action-close = Close
admin-action-remove = Remove
admin-action-save = Save
admin-message-done = Done.
admin-message-rejected = The wiki refused this: a value is not allowed, or the path is taken, or the page is not empty. Check the marked fields.
admin-message-not-found = There is no such page, folder or command any more; the list may be old.
admin-message-unavailable = The wiki did not do this: the server refused it or does not offer the command yet. The reason is written to the log of the program.
admin-message-unsaved = There is text that is not sent yet.
admin-list-empty = Nothing here.
admin-list-stale = The list may be old.
admin-detail-not-loaded = Not loaded.
admin-confirm-sure = Are you sure?
admin-value-none = none
admin-about-version = Version
admin-about-origin = Origin
admin-about-licence = Licence
admin-about-repository = Repository
admin-about-unoffered = Not offered
admin-type-page = Pages
admin-type-folder = Folders
admin-type-revision = History
admin-type-trash = Trash
admin-type-link = Links

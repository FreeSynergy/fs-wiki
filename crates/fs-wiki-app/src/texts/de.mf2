# Die Texte des Wiki-Fensters, Deutsch (ADR 0057: MessageFormat 2). Jede Id braucht ihr englisches Gegenstück in en.mf2.
# Ein Loch `{$x}` wird mit dem gefüllt, wovon der Satz spricht. Die Wörter der Layouts (wk-) und des Lesers (rd-) fragt
# fs-components ab; ein `{}` darin entsteht aus dem Argument `{$hole}`, das die zwei Zeichen enthält.

menu-program = Programm
menu-quit = Beenden
menu-view = Ansicht
menu-frontend = Frontend: {$name}
menu-page = Seite
page-new = Neue Seite
page-subpage = Neue Unterseite
page-rename = Umbenennen
page-delete = Löschen
page-discard = Entwurf verwerfen
reason-read-only = nur lesen: dieses Wiki wird hier nicht bearbeitet
reason-no-page = keine Seite offen
reason-no-draft = nichts wird bearbeitet
reason-editing = erst die Bearbeitung beenden
reason-variants = Seiten mit Sprachfassungen werden hier nicht geändert

msg-need-page = Zuerst eine Seite öffnen: die neue Seite wird ihre Unterseite.
msg-finish-edit = Erst die Änderungen speichern oder verwerfen, dann die Seiten ändern.
msg-created = Seite angelegt ({$path}). Text schreiben, dann speichern (Strg+S).
msg-renamed = Seite umbenannt: jetzt {$path}. Ihre Unterseiten und die Links auf sie sind mitgezogen; ihr Verlauf bleibt.
msg-deleted = In den Papierkorb gelegt: {$title}. Aus dem Papierkorb lässt sie sich zurückholen (Admin-Fenster).
msg-discarded = Der Entwurf ist verworfen.
msg-discarded-new = Die neue Seite wurde nie gespeichert; sie liegt im Papierkorb.
msg-frontend-not-kept = Das Frontend konnte nicht gemerkt werden.

dlg-delete-title = {$title} löschen?
dlg-delete-body = Die Seite kommt in den Papierkorb. Von dort lässt sie sich zurückholen.
dlg-delete-body-sub = Die Seite und ihre {$count} Unterseiten kommen in den Papierkorb. Von dort lassen sie sich zurückholen.
dlg-delete-yes = Löschen
dlg-discard-title = Entwurf von {$title} verwerfen?
dlg-discard-body = Was du getippt hast, ist nicht gespeichert und geht verloren.
dlg-discard-new-body = Die Seite wurde eben erst angelegt und nie gespeichert. Sie kommt in den Papierkorb.
dlg-discard-yes = Verwerfen
dlg-keep = Behalten

err-read-only = Das Wiki ist hier nur lesbar; nichts wurde geändert.
err-empty = Der Name ist leer.
err-no-letter = Der Name braucht mindestens einen Buchstaben oder eine Ziffer, aus der sich ein Pfad machen lässt.
err-chars = Der Name darf keinen Schrägstrich, keinen Rückwärtsstrich und keine Steuerzeichen enthalten.
err-taken = Unter {$path} gibt es schon eine Seite.
err-invalid = Der Pfad ist nicht erlaubt ({$why}).
err-failed = Nichts wurde geändert: {$why}
err-not-found = Unter {$path} gibt es keine Seite mehr.
err-variants = Seiten mit Sprachfassungen werden in diesem Fenster nicht geändert.
err-index = Eine Indexseite trägt den Namen ihres Ordners; den Ordner im Admin-Fenster umbenennen.
err-partial = Die Seite wurde umbenannt, aber der Titel in ihrem Text ließ sich nicht ändern: {$why}

wk-program = FreeSynergy Wiki
wk-pages = Seiten
wk-filter = Nach Titel suchen
wk-outline = Gliederung
wk-no-headings = Diese Seite hat keine Überschriften.
wk-history = Verlauf
wk-no-history = Keine früheren Fassungen bekannt.
wk-state-current = Aktuell
wk-state-outdated = Veraltet
wk-state-fallback = Andere Sprache
wk-language = Sprache
wk-edit = Bearbeiten
wk-share = Teilen
wk-block-hint = Schreiben, oder / für Befehle
wk-title-hint = Ohne Titel
wk-page-count = {$hole} Seiten

rd-search = Seiten suchen
rd-back = Zurück
rd-edit = Bearbeiten
rd-save = Speichern
rd-cancel = Abbrechen
rd-export = Exportieren
rd-nothing-open = Nichts anzuzeigen.
rd-nothing-found = Nichts gefunden für „{$hole}“.
rd-unreadable = Das ließ sich nicht lesen: {$hole}
rd-missing-target = Unter „{$hole}“ gibt es nichts.
rd-unsaved = Erst die Änderungen speichern oder abbrechen.
rd-discard-confirm = Es gibt ungespeicherte Änderungen. Noch einmal Abbrechen drücken, um sie zu verwerfen.
rd-saved = Gespeichert.
rd-no-changes = Nichts wurde geändert.
rd-not-saved = Nicht gespeichert: {$hole}
rd-cannot-edit = Das lässt sich nicht bearbeiten: {$hole}
rd-not-exported = Nicht exportiert: {$hole}
rd-overwrite-confirm = {$hole} Noch einmal Exportieren drücken, um sie zu ersetzen.
rd-lossy = Beim Speichern ändert sich auch: {$hole}.
rd-conflict-confirm = {$hole} Dein Text bleibt erhalten. Noch einmal Speichern drücken, um ihre Fassung zu ersetzen.
rd-backup-found = Ein früher nicht gespeicherter Entwurf wurde gesichert.
rd-restore = Wiederherstellen
rd-discard = Verwerfen
rd-backup-stale = Das Dokument hat sich geändert, nachdem dieser Entwurf entstand. Beim Speichern wird nachgefragt, bevor die neuere Fassung ersetzt wird.
rd-restore-confirm = Wiederherstellen ersetzt, was du getippt hast. Noch einmal Wiederherstellen drücken.
rd-backup-mismatch = Ein gesicherter Entwurf gehört zu einem anderen Dokument („{$hole}“) und wurde nicht angeboten.
rd-backup-failed = Die Sicherung deines Entwurfs ist fehlgeschlagen: {$hole}
rd-glyphs-missing = Einige Zeichen lassen sich nicht anzeigen, weil keine installierte Schrift sie hat ({$hole}). Installiere eine Schrift, die ihre Schrift abdeckt, zum Beispiel Noto Sans.
rd-glyphs-titles = Einige Titel in der Liste verwenden Zeichen, die sich nicht zeichnen lassen ({$hole}).
rd-glyphs-more = und {$hole} weitere
rd-list-failed = Die Liste ist fehlgeschlagen: {$hole}
rd-search-failed = Die Suche ist fehlgeschlagen: {$hole}

